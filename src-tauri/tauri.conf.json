{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VanTranscribe",
  "version": "0.1.0",
  "identifier": "com.dvrtech.vantranscribe",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "label": "main",
      "title": "VanTranscribe",
      "width": 1240,
      "height": 840,
      "minWidth": 860,
      "minHeight": 620,
      "backgroundColor": "#fffdf8"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "resources/vt-capture-helper": "vt-capture-helper",
      "resources/vt-summary-helper": "vt-summary-helper",
      "../crates/vt-stt/resources/": "licenses/",
      "../crates/vt-diarize/resources/": "licenses/diarization/",
      "../crates/vt-dsp/resources/": "licenses/echo/"
    },
    "macOS": {
      "minimumSystemVersion": "14.4",
      "signingIdentity": "-",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
